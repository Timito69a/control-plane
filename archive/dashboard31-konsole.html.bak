  </div>
<script>
    (function () {
      const STORAGE_KEY = "neuro-dashboard-enabled-apps-light-v5";
      const defaultEnabled = [
        "executive","erp","crm","hr","ai","system",
        "marketplace","chain","banking","accounting",
        "compliance","marketing","neuro"
      ];
      const topTabsEl = document.getElementById("topTabs");

      function loadEnabledApps() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return defaultEnabled.slice();
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length) return parsed;
          return defaultEnabled.slice();
        } catch {
          return defaultEnabled.slice();
        }
      }

      function saveEnabledApps(list) {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); } catch {}
      }

      function applyAppVisibility() {
        const enabled = loadEnabledApps();
        const nodes = document.querySelectorAll("[data-app]");
        nodes.forEach((el) => {
          const appsString = el.getAttribute("data-app") || "";
          const tags = appsString.split(",").map((s) => s.trim()).filter(Boolean);
          const visible = tags.length === 0 || tags.some((tag) => enabled.includes(tag));
          el.classList.toggle("hidden-app", !visible);
        });
        document.querySelectorAll("[data-app-toggle]").forEach((input) => {
          const appKey = input.getAttribute("data-app-toggle");
          input.checked = enabled.includes(appKey);
        });
      }

      function toggleApp(appKey, isEnabled) {
        let enabled = loadEnabledApps();
        if (isEnabled) {
          if (!enabled.includes(appKey)) enabled.push(appKey);
        } else {
          enabled = enabled.filter((k) => k !== appKey);
        }
        saveEnabledApps(enabled);
        applyAppVisibility();
      }

      document.querySelectorAll("[data-app-toggle]").forEach((input) => {
        input.addEventListener("change", (e) => {
          const key = e.target.getAttribute("data-app-toggle");
          toggleApp(key, e.target.checked);
        });
      });

      /* WORKSPACES & TABS */
      function setActiveWorkspace(workspaceId) {
        document.querySelectorAll(".workspace-view").forEach((w) => {
          w.classList.toggle("active", w.getAttribute("data-workspace") === workspaceId);
        });
      }

      function setActiveNav(workspaceId) {
        document.querySelectorAll(".nav-item").forEach((i) => {
          const ws = i.getAttribute("data-workspace");
          i.classList.toggle("active", ws === workspaceId);
        });
      }

      function setActiveTab(workspaceId) {
        const tabs = topTabsEl.querySelectorAll(".top-tab");
        tabs.forEach((tab) => {
          tab.classList.toggle("active", tab.getAttribute("data-workspace") === workspaceId);
        });
      }

      function createTab(workspaceId, label, pinned = false) {
        const tab = document.createElement("div");
        tab.className = "top-tab";
        tab.setAttribute("data-workspace", workspaceId);
        tab.innerHTML = `
          <span class="label">${label}</span>
          ${pinned ? "" : '<button class="close" title="Tab schließen">×</button>'}
        `;
        topTabsEl.appendChild(tab);

        tab.addEventListener("click", (e) => {
          if (e.target.classList.contains("close")) return;
          setActiveWorkspace(workspaceId);
          setActiveTab(workspaceId);
          setActiveNav(workspaceId);
        });

        if (!pinned) {
          const closeBtn = tab.querySelector(".close");
          closeBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const isActive = tab.classList.contains("active");
            tab.remove();
            if (isActive) {
              const remaining = topTabsEl.querySelector(".top-tab");
              if (remaining) {
                const ws = remaining.getAttribute("data-workspace");
                setActiveWorkspace(ws);
                setActiveTab(ws);
                setActiveNav(ws);
              } else {
                setActiveWorkspace("");
              }
            }
          });
        }
        return tab;
      }

      function openWorkspaceTab(workspaceId, label, pinned = false) {
        let tab = topTabsEl.querySelector(`.top-tab[data-workspace="${workspaceId}"]`);
        if (!tab) {
          tab = createTab(workspaceId, label, pinned);
        }
        setActiveWorkspace(workspaceId);
        setActiveTab(workspaceId);
        setActiveNav(workspaceId);
      }

      // Sidebar → Tabs
      document.querySelectorAll(".nav-item[data-workspace]").forEach((item) => {
        item.addEventListener("click", () => {
          const workspaceId = item.getAttribute("data-workspace");
          const label = item.getAttribute("data-label") || item.textContent.trim();
          openWorkspaceTab(workspaceId, label);
        });
      });

      // Sidebar-Gruppen als Akkordeon behandeln
      document.querySelectorAll(".sidebar-group-header").forEach((header) => {
        header.addEventListener("click", () => {
          const group = header.parentElement;
          if (!group) return;
          const sidebar = group.parentElement;
          if (sidebar) {
            sidebar.querySelectorAll(".sidebar-group").forEach((g) => {
              if (g !== group) g.classList.add("is-collapsed");
            });
          }
          const isCollapsed = group.classList.toggle("is-collapsed");
          // Speziell: Mandanten & Projekte → Übersicht öffnen
          const text = header.textContent || "";
          if (text.indexOf("Mandanten") !== -1 && text.indexOf("Projekte") !== -1) {
            // Nur beim Öffnen den Workspace setzen
            if (!isCollapsed) {
              openWorkspaceTab("tenant-summary", "Mandanten & Projekte");
            }
          }
        });
      });

      // Exponiere Funktion für Megamenüs / Schnellaktionen
      window.NeuroOpenWorkspaceTab = openWorkspaceTab;

      // Initial: Executive Tab
      openWorkspaceTab("executive", "Executive Übersicht", true);

      applyAppVisibility();

      /* MODAL-LOGIK */
      const modalBackdrops = document.querySelectorAll(".modal-backdrop");
      document.querySelectorAll("[data-modal-open]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetId = btn.getAttribute("data-modal-open");
          const modal = document.getElementById(targetId);
          if (modal) modal.classList.add("open");
        });
      });
      document.querySelectorAll("[data-modal-close]").forEach((btn) => {
        btn.addEventListener("click", () => {
          modalBackdrops.forEach((m) => m.classList.remove("open"));
        });
      });
      modalBackdrops.forEach((backdrop) => {
        backdrop.addEventListener("click", (e) => {
          if (e.target === backdrop) backdrop.classList.remove("open");
        });
      });

      // Modal Tabs
      document.querySelectorAll(".modal-tabs").forEach((tabs) => {
        const parent = tabs.closest(".modal");
        tabs.querySelectorAll(".modal-tab").forEach((tab) => {
          tab.addEventListener("click", () => {
            const t = tab.getAttribute("data-tab");
            tabs.querySelectorAll(".modal-tab").forEach((x) => x.classList.remove("active"));
            tab.classList.add("active");
            parent.querySelectorAll(".modal-tabpanel").forEach((panel) => {
              panel.classList.toggle("active", panel.getAttribute("data-tabpanel") === t);
            });
          });
        });
      });

    

      // Detail-Volltextsuche im Benutzer-Masterbrain
      const detailSearchInput = document.getElementById("detailSearchInput");
      if (detailSearchInput) {
        detailSearchInput.addEventListener("input", () => {
          const q = detailSearchInput.value.trim().toLowerCase();
          const blocks = document.querySelectorAll(
            '.workspace-view[data-workspace="user-edit"] .workspace--two-columns .section-block--collapsible'
          );
          if (!q) {
            blocks.forEach((b) => {
              b.style.display = "";
            });
            return;
          }
          blocks.forEach((b) => {
            const text = (b.textContent || "").toLowerCase();
            if (text.includes(q)) {
              b.style.display = "";
              b.classList.remove("section-block--collapsed");
            } else {
              b.style.display = "none";
            }
          });
        });
      }

      // Pop-down Verhalten: Sektionen ein- / ausklappen
      document.querySelectorAll(
        '.workspace-view[data-workspace="user-edit"] .section-block--collapsible .section-title'
      ).forEach((titleEl) => {
        titleEl.addEventListener("click", () => {
          const block = titleEl.closest(".section-block--collapsible");
          if (!block) return;
          block.classList.toggle("section-block--collapsed");
        });
      });
})();
  </script>

  <script>
    (function () {
      function pushToFeed(selector, payload) {
        var feed = document.querySelector(selector);
        if (!feed) return;
        var empty = feed.querySelector('.list-item--empty');
        if (empty) empty.remove();
        var li = document.createElement('li');
        li.className = 'list-item';
        var label = document.createElement('div');
        label.className = 'list-label';
        label.textContent = payload.title || payload.message || 'Event';
        var meta = document.createElement('div');
        meta.className = 'list-meta';
        meta.textContent = payload.meta || (payload.timestamp || '');
        var wrapper = document.createElement('div');
        wrapper.appendChild(label);
        wrapper.appendChild(meta);
        li.appendChild(wrapper);
        feed.prepend(li);
      }

      // P2P-Event-Listener (Peer2Peer-System)
      document.addEventListener('p2p-event', function (ev) {
        var d = ev.detail || {};
        if (d.peerId) {
          var row = document.querySelector('[data-peer-id="' + d.peerId + '"]');
          if (row) {
            row.classList.add('row--highlight');
            setTimeout(function () { row.classList.remove('row--highlight'); }, 1200);
          }
        }
        pushToFeed('[data-feed="p2p-events"]', d);
      });

      // Billing-Event-Listener (Abrechnungssystem / MLM)
      document.addEventListener('billing-event', function (ev) {
        var d = ev.detail || {};
        if (d.billingId) {
          var row = document.querySelector('[data-billing-id="' + d.billingId + '"]');
          if (row) {
            row.classList.add('row--highlight');
            setTimeout(function () { row.classList.remove('row--highlight'); }, 1200);
          }
        }
        pushToFeed('[data-feed="billing-events"]', d);
      });

      // AI-Broadcast-Listener (Mandanten & Projekte – Summary)
      document.addEventListener('ai-broadcast', function (ev) {
        var d = ev.detail || {};
        pushToFeed('[data-feed="ai-broadcast"]', d);
      });

      // Buttons mit data-jump-workspace nutzen bestehende Tabs/Navigation
      document.addEventListener('click', function (ev) {
        var btn = ev.target.closest('[data-jump-workspace]');
        if (!btn) return;
        var target = btn.getAttribute('data-jump-workspace');
        if (!target) return;
        if (window.NeuroOpenWorkspaceTab) {
          window.NeuroOpenWorkspaceTab(target, btn.textContent.trim() || target);
        } else {
          var navItem = document.querySelector('.nav-item[data-workspace="' + target + '"]');
          if (navItem) navItem.click();
        }
      });
    })();
  </script>

<script>

      // User-Karteikarte mit Tabellenzeile verbinden
      document.addEventListener('click', function (ev) {
        var row = ev.target.closest('table[data-user-table="employees"] tr.user-row');
        if (!row) return;
        var table = row.closest('table[data-user-table="employees"]');
        if (table) {
          table.querySelectorAll('tr.user-row').forEach(function (r) { r.classList.remove('is-selected'); });
        }
        row.classList.add('is-selected');
        var card = document.querySelector('[data-user-card]');
        if (!card) return;
        function setField(sel, value) {
          var el = card.querySelector(sel);
          if (!el || typeof value === 'undefined') return;
          if (el.tagName === 'INPUT') {
            el.value = value;
          } else {
            el.textContent = value;
          }
        }
        var name = row.getAttribute('data-user-name');
        var email = row.getAttribute('data-user-email');
        var country = row.getAttribute('data-user-country');
        var tenant = row.getAttribute('data-user-tenant');
        var project = row.getAttribute('data-user-project');
        var role = row.getAttribute('data-user-role');
        var status = row.getAttribute('data-user-status');
        var level = row.getAttribute('data-user-level');

        setField('[data-user-field="name"]', name);
        setField('[data-user-field="roleStatus"]', (role || '') + (status ? ' · ' + status : ''));
        setField('[data-user-field="tenant-badge"]', tenant);
        setField('[data-user-field="country-badge"]', country);
        setField('[data-user-field="level-badge"]', 'Level ' + (level || ''));
        setField('[data-user-field="email-input"]', email);
        setField('[data-user-field="tenant"]', tenant);
        setField('[data-user-field="country"]', country);
        setField('[data-user-field="status"]', status);
        setField('[data-user-field="project"]', project);
        setField('[data-user-field="role"]', role);
        setField('[data-user-field="level"]', level);
        // P2P Peer-ID könnte aus einem Mapping oder direkt aus data-peer-id kommen
        var peerId = row.getAttribute('data-peer-id') || '';
        setField('[data-user-field="peerId"]', peerId);
      });

</script>

<script>
  // Tabs in der Mandanten-Karteikarte
  document.addEventListener('click', function (ev) {
    var tab = ev.target.closest('.tenant-card-tab');
    if (!tab) return;
    var card = tab.closest('.card');
    if (!card) return;
    var target = tab.getAttribute('data-tenant-tab');
    card.querySelectorAll('.tenant-card-tab').forEach(function (t) {
      t.classList.toggle('is-active', t === tab);
    });
    card.querySelectorAll('.tenant-card-panel').forEach(function (panel) {
      panel.classList.toggle('is-active', panel.getAttribute('data-panel') === target);
    });
  });
</script>


<script>
  document.addEventListener('click', function (ev) {
    var openTrigger = ev.target.closest('[data-modal-open]');
    if (openTrigger) {
      var id = openTrigger.getAttribute('data-modal-open');
      if (!id) return;
      var backdrop = document.getElementById(id);
      if (backdrop) {
        backdrop.classList.add('open');
      }
    }
    var closeTrigger = ev.target.closest('[data-modal-close]');
    if (closeTrigger) {
      var backdrop = closeTrigger.closest('.modal-backdrop');
      if (backdrop) {
        backdrop.classList.remove('open');
      }
    }
  });
</script>


  <script>
    (function () {
      function setActiveView(view) {
        var items = document.querySelectorAll('.tenant-accordion .accordion-item');
        items.forEach(function (item) {
          var v = item.getAttribute('data-tenant-panel-view');
          item.classList.toggle('is-active', v === view);
        });

        var panels = document.querySelectorAll('.tenant-workspace-panel');
        panels.forEach(function (panel) {
          var v = panel.getAttribute('data-tenant-panel-view');
          panel.classList.toggle('is-active', v === view);
        });

        var pills = document.querySelectorAll('.workspace-tab-pill');
        pills.forEach(function (pill) {
          var v = pill.getAttribute('data-tab-target');
          pill.classList.toggle('is-active', v === view);
        });
      }

      document.addEventListener('click', function (ev) {
        var accItem = ev.target.closest('.tenant-accordion .accordion-item');
        if (accItem) {
          var view = accItem.getAttribute('data-tenant-panel-view');
          if (view) {
            setActiveView(view);
          }
        }
        var pill = ev.target.closest('.workspace-tab-pill');
        if (pill) {
          var view2 = pill.getAttribute('data-tab-target');
          if (view2) {
            setActiveView(view2);
          }
        }
      });
    })();
  </script>

<script>
  (function () {
    var workspace = document.querySelector('.workspace-view[data-workspace="user-admin"]');
    if (!workspace) return;
    var searchInput = workspace.querySelector('.toolbar-search-input');
    var rows = workspace.querySelectorAll('.result-table tbody tr');

    if (!searchInput || !rows.length) return;

    function applyFilter() {
      var q = searchInput.value.toLowerCase().trim();
      rows.forEach(function (row) {
        var text = row.textContent.toLowerCase();
        var match = !q || text.indexOf(q) !== -1;
        row.style.display = match ? '' : 'none';
      });
    }

    searchInput.addEventListener('input', applyFilter);
  })();
</script>

<script>
  (function () {
    // Kontextmenü im Ergebnis-Grid
    document.addEventListener('click', function (evt) {
      var toggle = evt.target.closest('[data-actions-toggle]');
      var allPanels = document.querySelectorAll('.actions-menu-panel');
      if (!toggle) {
        // Klick außerhalb: alle Menüs schließen
        allPanels.forEach(function (p) { p.classList.remove('is-open'); });
        return;
      }
      var menu = toggle.parentElement.querySelector('[data-actions-panel]');
      if (!menu) return;
      var isOpen = menu.classList.contains('is-open');
      allPanels.forEach(function (p) { p.classList.remove('is-open'); });
      if (!isOpen) {
        menu.classList.add('is-open');
      }
    });

    // Optionaler Hook: im Kontextmenü "Bearbeiten / Status ändern" -> Verwaltungstab im Modal
    document.addEventListener('click', function (evt) {
      var manageBtn = evt.target.closest('[data-open-manage-tab]');
      if (!manageBtn) return;
      var modal = document.getElementById('userDetailModal');
      if (!modal) return;
      // Modal öffnen
      modal.classList.add('open');
      
      // Verwaltungstab aktivieren
      var tabs = modal.querySelectorAll('.modal-tab');
      var panels = modal.querySelectorAll('.modal-tabpanel');
      tabs.forEach(function (t) {
        if (t.getAttribute('data-tab') === 'user-manage') {
          t.classList.add('active');
        } else {
          t.classList.remove('active');
        }
      });
      panels.forEach(function (p) {
        if (p.getAttribute('data-tabpanel') === 'user-manage') {
          p.classList.add('active');
        } else {
          p.classList.remove('active');
        }
      });
    });
  })();
</script>

<script>
  (function () {
    document.addEventListener('click', function (evt) {
      var btn = evt.target.closest('[data-open-edit-workspace]');
      if (!btn) return;

      // Alle Modals schließen (Dashboard-Layer bleibt erhalten)
      document.querySelectorAll('.modal-backdrop').forEach(function (m) { m.classList.remove('open'); });

      // Ziel-Tab im Dashboard öffnen (Workspace = user-edit)
      var modal = document.getElementById('userDetailModal');
      var titleEl = modal ? modal.querySelector('.modal-title') : null;
      var raw = titleEl ? (titleEl.textContent || '').trim() : '';
      var name = raw.replace('Benutzer 360° –', '').trim() || 'Benutzer';
      var label = 'Bearbeiten – ' + name;

      if (window.NeuroOpenWorkspaceTab) {
        window.NeuroOpenWorkspaceTab('user-edit', label);
      } else {
        // Fallback: direkt aktivieren
        document.querySelectorAll('.workspace-view').forEach(function (v) { v.classList.remove('active'); });
        var target = document.querySelector('.workspace-view[data-workspace="user-edit"]');
        if (target) target.classList.add('active');
      }
    });
  })();
</script>
<script type="module" src="/core/control.js"></script>
<script type="module" src="/core/control.js"></script>
<script src="/core/ui-bridge.js"></script>
</body>
</html>
